  "agents": {
    "codex": {
      "display_name": "Codex",
      "detection": {
        "command": "codex",
        "args": [
          "--version"
        ]
      },
      "invocation": {
        "command": "codex",
        "args_template": [
          "exec",
          "-C",
          "{{repo_root}}",
          "{{permission_mode}}",
          "{{model_flag}}",
          "{{extra_args}}",
          "{{model_settings}}",
          "{{prompt}}"
        ],
        "prompt_argument_template": "{{prompt}}"
      },
      "liveness": {
        "streaming_output": true,
        "wrapper_heartbeat_required": true
      },
      "permission_modes": {
        "default": "--dangerously-bypass-approvals-and-sandbox",
        "read_only": "--sandbox=read-only",
        "available": [
          "--dangerously-bypass-approvals-and-sandbox",
          "--sandbox=read-only",
          "--sandbox=workspace-write"
        ],
        "_note": "read_only is the profile --permission-mode safe resolves to. Codex enforces it in its own sandbox; it must deny writes to the workspace."
      },
      "model": {
        "default": "",
        "flag_template": "--model {{model}}",
        "known_models": [
          "gpt-5.6-sol",
          "gpt-5.6-terra",
          "gpt-5.6-luna",
          "gpt-5.5",
          "gpt-5.4",
          "gpt-5.4-mini",
          "gpt-5.3-codex-spark"
        ],
        "pricing_basis": "subscription",
        "metered_api_cost": false,
        "_note": "Codex automatic routing follows model_routing.non_complexity_band_policy. GPT-5.5 is medium-hard only; GPT-5.4 is limited to simple work."
      },
      "capability_band": "advanced",
      "fallback_order": [
        "agy",
        "claude"
      ],
      "user_model_configuration": {
        "requires_user_model_config": false,
        "config_paths": [],
        "skip_when_unconfigured": false,
        "skip_message": ""
      }
    },
    "claude": {
      "display_name": "Claude Code",
      "detection": {
        "command": "claude",
        "args": [
          "--version"
        ]
      },
      "invocation": {
        "command": "claude",
        "args_template": [
          "{{permission_mode}}",
          "{{model_flag}}",
          "{{model_settings}}",
          "{{extra_args}}",
          "--print",
          "{{prompt}}"
        ],
        "prompt_argument_template": "{{prompt}}"
      },
      "liveness": {
        "streaming_output": false,
        "wrapper_heartbeat_required": true
      },
      "permission_modes": {
        "default": "--dangerously-skip-permissions",
        "read_only": "--permission-mode=plan",
        "available": [
          "--dangerously-skip-permissions",
          "--permission-mode=plan"
        ],
        "_note": "plan mode is Claude Code's write-denying mode: it may read and research but may not edit, write, or run mutating commands. It is what --permission-mode safe resolves to."
      },
      "model": {
        "default": "claude-sonnet-4-6",
        "flag_template": "--model {{model}}",
        "known_models": [
          "claude-fable-5",
          "claude-opus-5",
          "claude-sonnet-5",
          "claude-sonnet-4-6",
          "claude-haiku-4-5"
        ],
        "pricing_basis": "subscription",
        "metered_api_cost": false,
        "_note": "Claude CLI uses Anthropic model IDs: hyphens and full versioned names."
      },
      "capability_band": "advanced",
      "fallback_order": [
        "codex",
        "agy"
      ],
      "user_model_configuration": {
        "requires_user_model_config": false,
        "config_paths": [],
        "skip_when_unconfigured": false,
        "skip_message": ""
      }
    },
    "github-copilot": {
      "routing_disabled": true,
      "routing_disabled_reason": "GitHub Copilot plan is exhausted; keep blocked from automatic routing and direct run-agent use until explicitly re-enabled.",
      "display_name": "GitHub Copilot",
      "detection": {
        "command": "copilot",
        "args": [
          "--version"
        ]
      },
      "invocation": {
