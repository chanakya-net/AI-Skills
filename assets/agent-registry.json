      },
      "anthropic": {
        "automatic_routing": "all",
        "preferred_agents": [
          "claude"
        ],
        "fallback_agents": [
          "claude"
        ],
        "_note": "Anthropic models route through any available agent, preferring direct Claude for the active Claude subscription. claude-opus-5 is min_band=medium-hard and should not appear below that band; claude-fable-5 is min_band=holy-fuck. Opus routing uses only the Opus 5 series."
      }
    },
    "hard_minimum_overrides": [
